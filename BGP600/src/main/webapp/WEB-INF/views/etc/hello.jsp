<%@ page language="java" contentType="text/html; charset=UTF-8" pageEncoding="UTF-8"%>
<!--
    JSP 페이지 지시자
    language="java" : JSP에서 사용하는 스크립트 언어를 Java로 지정
    contentType="text/html; charset=UTF-8" : 클라이언트로 전송되는 문서의 타입과 문자 인코딩
    pageEncoding="UTF-8" : JSP 파일 자체의 문자 인코딩
-->

<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Hello Include Page</title> <!-- 브라우저 탭에 표시될 제목 -->
</head>
<body>
    <!-- include 실습용 메시지 -->
    <h2 class="shine-text">
        이 페이지는 include 실습을 위해 작성된 hello.jsp 내용입니다.
    </h2>
</body>
</html>
